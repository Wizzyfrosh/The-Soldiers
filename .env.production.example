# ==============================================================================
# Soldiers of Jesus Christ Platform - Production Environment Configuration
# SECURITY WARNING: DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & PERSISTENCE (Neon Postgres)
# ------------------------------------------------------------------------------
# Neon connection string with pooling enabled (`?sslmode=require`)
DATABASE_URL="postgresql://neon_user:your_secure_db_password@ep-prod-pooler.us-east-2.aws.neon.tech/soldiers_db?sslmode=require"

# Direct unpooled connection string for running Prisma migrations
DIRECT_URL="postgresql://neon_user:your_secure_db_password@ep-prod-direct.us-east-2.aws.neon.tech/soldiers_db?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Production secret generated via `openssl rand -base64 32` (MUST be unique & private)
NEXTAUTH_SECRET="your_nextauth_secret_generated_via_openssl_rand_base64_32"
NEXTAUTH_URL="https://soldiersofjesuschrist.org"

# JWT Secret for Express server API authentication
JWT_SECRET="your_jwt_secret_generated_via_openssl_rand_base64_32"

# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENTS & ONLINE TITHING
# ------------------------------------------------------------------------------
# Production Publishable Key (safe for client exposure)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_publishable_key_here"
VITE_STRIPE_PUBLIC_KEY="pk_live_your_stripe_publishable_key_here"

# Secret Key (Backend ONLY — Never expose with NEXT_PUBLIC_ or VITE_)
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key_here"

# Production Webhook Secret (from Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# ------------------------------------------------------------------------------
# 4. CLOUDINARY & MEDIA ASSETS
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="soldiers-church-prod"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="soldiers-church-prod"

# ------------------------------------------------------------------------------
# 5. SENDGRID EMAIL SERVICE
# ------------------------------------------------------------------------------
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
CHURCH_ADMIN_EMAIL="info@soldiersofjesuschrist.org"
FROM_EMAIL="noreply@soldiersofjesuschrist.org"

# ------------------------------------------------------------------------------
# 6. EXTERNAL APIS & INTEGRATIONS
# ------------------------------------------------------------------------------
VITE_YOUTUBE_API_KEY="your_youtube_api_key_here"
VITE_YOUTUBE_CHANNEL_ID="your_youtube_channel_id_here"

# ------------------------------------------------------------------------------
# 7. PUBLIC APPLICATION METADATA & URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://soldiersofjesuschrist.org"
VITE_SITE_URL="https://soldiersofjesuschrist.org"
PORT="5000"
NODE_ENV="production"
