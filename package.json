{
  "name": "soldiers-of-jesus-christ-church",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"tsx server/index.ts\" \"vite\"",
    "build": "prisma generate && prisma db push && tsc && vite build",
    "build:next": "prisma generate && prisma migrate deploy && next build",
    "lint": "tsc",
    "preview": "vite preview",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "framer-motion": "^13.4.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.441.0",
    "multer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^5.4.3"
  }
}
