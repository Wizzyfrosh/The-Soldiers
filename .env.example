# Soldiers of Jesus Christ - Environment Variables Template (.env.example)

DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

VITE_STRIPE_PUBLIC_KEY="pk_test_xxx"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

VITE_YOUTUBE_API_KEY="AIzaSy_xxx"
VITE_YOUTUBE_CHANNEL_ID="UC_xxx"

SENDGRID_API_KEY="SG_xxx"
CHURCH_ADMIN_EMAIL="info@soldiersofjesuschrist.org"

VITE_SITE_URL="http://localhost:3000"

# Database Seed Passwords (used only by `npm run db:seed`)
ADMIN_SEED_PASSWORD="your_strong_admin_password"
EDITOR_SEED_PASSWORD="your_strong_editor_password"
VIEWER_SEED_PASSWORD="your_strong_viewer_password"

# Cloudinary Media Storage (Optional — Cloud media storage for production serverless hosting)
# If left empty, the server automatically defaults to local disk storage (/public/uploads)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"